# ==============================================================================
# LoanVerify — Global .gitignore
# Covers Node.js, Vite/React Web Dashboard, Expo/React Native Mobile, Firebase,
# and Express backend environments.
# ==============================================================================

# --- Node & Package Dependencies ---
node_modules/
*/node_modules/
*/*/node_modules/
.pnp
.pnp.js

# --- Environment Variables, Secrets & Credentials ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!*.env.example
*.pem
*.key
*.cert
*.crt
serviceAccountKey.json
service-account*.json
google-services.json
GoogleService-Info.plist

# --- Build Outputs, Bundles & Compiled Code ---
dist/
*/dist/
build/
*/build/
out/
*/out/
functions/lib/
*.tsbuildinfo

# --- Expo & Mobile Artifacts ---
.expo/
*/.expo/
.expo-shared/
*/.expo-shared/
web-build/
*/web-build/
*.apk
*.aab
*.ipa
*.jks
*.keystore

# --- Logs & Debug Dumps ---
*.log
*.log.*
server.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
firebase-debug.log*
firestore-debug.log*
ui-debug.log*

# --- Cache & Temporary Files ---
.cache/
*/.cache/
.parcel-cache/
.turbo/
.eslintcache
.stylelintcache
.temp/
tmp/
*.tmp

# --- Testing & Coverage Reports ---
coverage/
*/coverage/
.nyc_output/

# --- IDE & Editor Artifacts ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
