{
  "name": "loanverify-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions AI Validation Pipeline for LoanVerify",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "ts-node src/testPipeline.ts"
  },
  "dependencies": {
    "@google-cloud/vision": "^4.3.2",
    "cors": "^2.8.5",
    "firebase-admin": "^12.3.0",
    "firebase-functions": "^5.0.0",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.13.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "private": true
}
